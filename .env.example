# このファイルをコピーして .env.local を作成し、実際の値を入力してください。
# .env.local はGit管理対象外です(.gitignore参照)。
# Vercelにデプロイする場合は、これらの値をVercelプロジェクトの
# Settings > Environment Variables に設定してください(.envファイルはVercelには反映されません)。

# Resendダッシュボード(https://resend.com/api-keys)で発行したAPIキー [必須]
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# 送信元アドレス。Resendで検証済みの独自ドメインを推奨 [任意/未設定時は onboarding@resend.dev]
RESEND_FROM_EMAIL=no-reply@yourdomain.com

# 問い合わせの届け先アドレス [任意/未設定時は whitephat7@gmail.com]
CONTACT_TO_EMAIL=whitephat7@gmail.com
